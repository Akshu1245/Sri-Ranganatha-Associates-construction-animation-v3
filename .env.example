# Copy this file to .env.local and fill in real values.
# .env / .env.local are gitignored — never commit real secrets.

# ── Admin login ──────────────────────────────────────────────
# Pick your own username/password. These are never sent to the browser.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Random secret used to sign the admin session cookie.
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ── Contact form email delivery ─────────────────────────────
# Any SMTP account works (Gmail with an App Password, Zoho Mail, etc).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Optional — defaults to SMTP_USER if unset
SMTP_FROM=your-email@gmail.com
# Where enquiry emails are delivered
LEAD_TO_EMAIL=owner@example.com
